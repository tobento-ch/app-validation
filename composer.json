{
    "name": "tobento/app-validation",
    "version": "2.0",
    "type": "library",
    "description": "App validation support.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "validation",
        "validator"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/service-validation": "^2.0",
        "tobento/service-message": "^2.0"
    },
    "suggest": {
        "tobento/app-translation": "Support for translating messages",
        "tobento/app-http": "Support for Http validation"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/app-translation": "^2.0",
        "tobento/app-http": "^2.0",
        "tobento/app-view": "^2.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Validation\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Validation\\Test\\": "tests",
            "Tobento\\App\\Http\\Test\\": "vendor/tobento/app-http/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}